# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key

# Azure OpenAI (for AzureChatOpenAI / model ids like azure-gpt-4o)
AZURE_OPENAI_API_KEY=your-api-key
# Optional if you use model ids like azure-<deploymentName>
AZURE_OPENAI_API_DEPLOYMENT_NAME=your-deployment-name
# Must end with /openai/deployments/
AZURE_OPENAI_BASE_PATH=your-base-path
# Optional (defaults are provider-dependent)
AZURE_OPENAI_API_VERSION=your-api-version

# Finance data providers
#
# Preferred (supports fallback): ordered, comma-separated provider list.
# Example: FINANCE_PROVIDERS=fmp,alphavantage,financialdatasets
#
# Supported providers: financialdatasets | alphavantage | fmp
FINANCE_PROVIDERS=financialdatasets

# Backward-compatible single-provider config (ignored if FINANCE_PROVIDERS is set)
FINANCE_PROVIDER=financialdatasets

# Finance API Keys
FINANCIAL_DATASETS_API_KEY=your-api-key
ALPHAVANTAGE_API_KEY=your-api-key
FMP_API_KEY=your-api-key

# Alpha Vantage throttling (ms between requests). Default is ~1100.
ALPHAVANTAGE_MIN_INTERVAL_MS=1100

# Web Search API Key
TAVILY_API_KEY=your-api-key

# LangSmith 
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=true

# LLM rate limiting / 429 retries
#
# Dexter can throttle and retry LLM calls to reduce 429s.
# - Concurrency is the biggest lever for avoiding bursts.
# - RPM/TPM are best-effort pacing using estimated tokens.
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_MS=0
LLM_REQUESTS_PER_MINUTE=
LLM_TOKENS_PER_MINUTE=
LLM_RATE_LIMIT_JITTER_MS=250

# Retry tuning (applies to non-streaming calls; streaming retries only before any tokens are received)
LLM_RETRY_MAX_ATTEMPTS=6
LLM_RETRY_BASE_DELAY_MS=750
LLM_RETRY_MAX_DELAY_MS=30000
LLM_RETRY_JITTER_RATIO=0.2